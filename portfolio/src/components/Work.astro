---
import { getContent } from "../lib/content";
const { projects } = await getContent();
const detailData = JSON.stringify(Object.fromEntries(projects.map(project => [project.key, project]))).replace(/</g, "\\u003c");
---
<section class="work-section work-page section" id="work" aria-labelledby="work-title"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">JAKE DEVWORKS / SELECTED WORK</p><h1 id="work-title">A few things<br>I’ve <em>worked on.</em></h1></div><p>Client projects, technical experience,<br>and ideas explored along the way.</p></div>
      <div class="filters" role="group" aria-label="Filter projects"><button aria-pressed="true" data-filter="all">All work <span>{String(projects.length).padStart(2, '0')}</span></button><button aria-pressed="false" data-filter="websites">Websites & presence</button><button aria-pressed="false" data-filter="software">Software</button><button aria-pressed="false" data-filter="personal">Personal projects</button></div>
      <p class="sr-only" id="filter-status" aria-live="polite"></p>
      <div class="project-grid">{projects.map(project => (
        <article class:list={['project', {'compact-project': project.visual === 'compact', 'project-wide': project.wide}]} data-category={project.filter}>
          {project.visual === 'electronics' && <div class="project-visual electronics" aria-hidden="true"><div class="visual-wordmark">LANCLOS<span>ELECTRONICS</span></div><div class="circuit circuit-one"></div><div class="circuit circuit-two"></div><span class="visual-caption">BUSINESS WEBSITE / CLIENT PROJECT</span><span class="visual-arrow">↗</span></div>}
          {project.visual === 'nasa' && <div class="project-visual nasa" aria-hidden="true"><div class="rfid-orbit ring-1"></div><div class="rfid-orbit ring-2"></div><div class="rfid-orbit ring-3"></div><div class="rfid-core">RFID<span>ASSET TRACKING</span></div><span class="visual-caption">JAVA / MYSQL / HARDWARE INTEGRATION</span><span class="visual-arrow">↗</span></div>}
          {project.visual === 'compact' && <div class="compact-symbol purple-symbol" aria-hidden="true">{project.symbol || '↗'}</div>}
          <div class:list={{'project-copy': project.visual !== 'compact'}}><div class="project-meta">{project.labels.map(label => <span>{label}</span>)}</div><h2><button data-project={project.key}>{project.title} <span aria-hidden="true">↗</span></button></h2><p>{project.summary}</p></div>
        </article>
      ))}</div>
      <script type="application/json" id="project-data" set:html={detailData}/>
      <div class="printing-callout"><span class="eyebrow">FROM THE WORKBENCH</span><div><h2>Your next idea could be a physical one.</h2><p>Explore my 3D prints, personal projects, and ideas taking shape at the workbench.</p></div><a class="button button-outline" href="/creations/">Explore my creations <span aria-hidden="true">↗</span></a></div>
    </div></section>
