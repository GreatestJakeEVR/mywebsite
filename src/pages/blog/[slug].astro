---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getContent } from '../../lib/content';
import { renderBody, type Post } from '../../lib/content-model';
export async function getStaticPaths() {
  const { posts } = await getContent();
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}
interface Props { post: Post }
const { post } = Astro.props;
const date = new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' });
---
<BaseLayout title={`${post.title} · Jake DevWorks`} description={post.excerpt}>
  <SiteHeader article/>
  <main id="main">
    <header class="article-header"><div class="wrap"><a class="text-link" href="/blog/">← Notes from the workbench</a><p class="eyebrow">{post.category || 'FROM THE WORKBENCH'}</p><h1>{post.title}</h1><p class="article-meta">{post.author || 'Jake DevWorks'} <span aria-hidden="true">·</span> <time datetime={post.publishedAt}>{date}</time></p></div></header>
    <article class="article-body"><div set:html={renderBody(post.body)}/><a class="button button-gold" href="/#contact">Tell me about your project ↗</a></article>
  </main>
  <SiteFooter article/>
</BaseLayout>
