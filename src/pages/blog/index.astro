---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BlogWelcome from '../../components/BlogWelcome.astro';
import PostCard from '../../components/PostCard.astro';
import { getContent } from '../../lib/content';
const { posts } = await getContent();
---
<BaseLayout title="The blog · Jake DevWorks" description="Welcome to the Jake DevWorks blog: notes on software, websites, design, 3D printing, and the process behind the work.">
  <SiteHeader article/>
  <main id="main">
    <BlogWelcome/>
    <section class="section wrap blog-posts" aria-labelledby="start-title">
      <div class="section-heading">
        <div><p class="eyebrow">NOTES FROM THE WORKBENCH</p><h2 id="start-title">The latest <em>posts.</em></h2></div>
        <p>Ideas, experiments,<br>and the process behind the work.</p>
      </div>
      <div class="blog-post-list">{posts.map(post => <PostCard post={post}/>)}</div>
      {!posts.length && <p>New notes are on the way. Check back soon.</p>}
    </section>
  </main>
  <SiteFooter article/>
</BaseLayout>
