# Website build (public dataset; no API token needed for published reads)
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_STUDIO_URL=

# Sanity Studio uses these public identifiers, never an API write token.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Set true on hosting after initial import to fail builds if CMS is unavailable.
REQUIRE_SANITY=false
