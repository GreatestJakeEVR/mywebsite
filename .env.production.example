# Copy to .env.production on the server. Never commit the real file.
SITE_HOSTNAME=www.jakeardoin.com
APEX_HOSTNAME=jakeardoin.com
SITE_URL=https://www.jakeardoin.com
DJANGO_ALLOWED_HOSTS=www.jakeardoin.com,jakeardoin.com
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_50_CHARACTERS_LONG
# Generate a hex password so it is safe inside DATABASE_URL without URL encoding.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
AWS_STORAGE_BUCKET_NAME=REPLACE_WITH_MEDIA_BUCKET
AWS_S3_REGION_NAME=us-east-1
# Use the distribution's d...cloudfront.net hostname, without https:// or a slash.
AWS_CLOUDFRONT_DOMAIN=REPLACE_WITH_DISTRIBUTION_DOMAIN
# Temporary AWS credentials come from the EC2 instance role. Do not add access keys.
BACKUP_BUCKET_NAME=REPLACE_WITH_BACKUP_BUCKET
# Configure an SMTP provider such as Amazon SES before using password reset.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@jakeardoin.com
